# 尘世浮生 · 生产环境变量(cp .env.prod.example .env.prod 后填写)
# 必填 ───────────────────────────────────────────────
# 强随机:openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# LLM(剧本生成 + 对话;官方 key 或兼容端点二选一)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5

# 生图(codex 走 OpenAI 兼容;或留空只用剧本生成)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 可选 ───────────────────────────────────────────────
# 游戏服务的访问口令与生图代理兜底 key
POLARIS_AUTH_TOKEN=
IMAGE_API_KEY=

# 配额与并发
WORKER_CONCURRENCY=4
MAX_ACTIVE_JOBS_PER_USER=2
DAILY_JOB_QUOTA=50
SCRIPT_TIMEOUT_SECS=600
IMAGE_TIMEOUT_SECS=300

# 国内镜像源(构建期)
NPM_REGISTRY=https://registry.npmmirror.com
