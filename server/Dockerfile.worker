# 尘世浮生 · 生成 worker 镜像
# 内置 claude / codex CLI;以非 root(node)运行,配合 compose 的
# read_only + no-new-privileges + 资源限额构成沙箱。
FROM node:22-alpine
ENV NODE_ENV=production
RUN apk add --no-cache git ripgrep
ARG NPM_REGISTRY=https://registry.npmmirror.com
# 生成 CLI:claude(剧本) + codex(生图)
RUN npm install -g @anthropic-ai/claude-code @openai/codex --registry=$NPM_REGISTRY \
    && npm cache clean --force
WORKDIR /app
COPY worker/package.json ./
RUN npm install --omit=dev --registry=$NPM_REGISTRY && npm cache clean --force
COPY worker/src ./src
# 任务工作区与产物目录(compose 分别挂 tmpfs / 数据卷)
RUN mkdir -p /work/jobs /data/assets && chown -R node:node /work /data
USER node
CMD ["node", "src/worker.mjs"]
