# worker 容器：唯一持有 CLI 与生图凭据的地方。
FROM rust:1-slim AS build
WORKDIR /src
COPY backend/ backend/
RUN cd backend && cargo build --release -p worker

FROM node:22-slim
# worker 内置 node —— compile 任务调 engine-runtime/compile.mjs，保产物与前端逐字节一致。
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# 双 CLI：梯队一生图靠 codex
RUN npm i -g @anthropic-ai/claude-code @openai/codex

COPY --from=build /src/backend/target/release/chenshi-worker /usr/local/bin/
COPY frontend/packages/engine-runtime/ /opt/engine-runtime/
ENV CHENSHI_COMPILER=/opt/engine-runtime/compile.mjs

# 生图沙箱：--dangerously-bypass 只允许出现在这个一次性容器里，宿主机永不。
USER node
CMD ["chenshi-worker"]
