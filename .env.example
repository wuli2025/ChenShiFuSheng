# 复制为 .env 后填写；docker compose 会自动读取。
# ── 接入 LLM（三选一）──
# A. Claude 官方 API Key
ANTHROPIC_API_KEY=

# B. 第三方 Anthropic 兼容端点（智谱/Kimi/DeepSeek/聚合站等）
#    填 BASE_URL + AUTH_TOKEN，留空 ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# ── 访问口令（公网部署强烈建议设置；浏览器用 http://host:8080/?token=xxx 访问）──
POLARIS_AUTH_TOKEN=

# ── 生图（可选）──
# 构建期注入的默认 StepFun key（前端默认配置用；不填则用户需在设置里自己填 key）
# 注意：任何打进前端产物的 key 都可被提取，只放低额度、可随时轮换的 key。
VITE_STEPFUN_API_KEY=

# Docker 部署时服务端生图代理的兜底 key（前端没填 key 时由服务端注入，不下发到浏览器）
IMAGE_API_KEY=

# Docker 部署时 lite-server 调用的模型（Anthropic 兼容名）
ANTHROPIC_MODEL=claude-sonnet-5
