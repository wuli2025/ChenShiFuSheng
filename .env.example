# ============================================================================
# 尘世浮生 · 环境变量。复制为 .env 后按需改。
# secrets 永不进 git（.gitignore 排除 .env；pre-commit 有 gitleaks 钩子）。
#
# 注意：**对话与生图的 API key 不在这里配**，而在「设置 → API 供应商坞」里，
# 加密落库。provider-dock 是隔离板块，其余模块拿到的只是不透明的 EnvPatch。
# ============================================================================

# ---- 数据目录（两端同一路径约定）
# Windows 默认 D:\chenshi-data；Linux/容器默认 /data/chenshi
# 网页端**不提供**目标文件夹选择，产物一律写这里，零路径询问。
CHENSHI_DATA_DIR=D:\chenshi-data

# ---- api
PORT=8080
RUST_LOG=info
# 留空则用 EmbeddedStore（JSON 文件，桌面/单机）。生产必须配 PG。
DATABASE_URL=postgres://chenshi:CHANGE_ME@pg/chenshi
REDIS_URL=redis://redis:6379
# api 兜底托管前端；生产由 nginx 直出，这项可不设。
CHENSHI_WEB_DIR=../frontend

# ---- 配额（每项目 1 重任务 + N 轻任务；每用户跨项目总并发）
CHENSHI_QUOTA_PROJECT_HEAVY=1
CHENSHI_QUOTA_PROJECT_LIGHT=4
CHENSHI_QUOTA_USER_TOTAL=4

# ---- worker
# 并发消费槽。串行会让一个重任务（写剧本要十几分钟）把所有轻任务堵死。
CHENSHI_WORKER_SLOTS=4
# 只走流程不真调 CLI（调试用，跳过所有 AI 调用，不烧 token）
# CHENSHI_DRY_RUN=1
# compile 任务调的编译器（worker 容器内置 node）
CHENSHI_COMPILER=/opt/engine-runtime/compile.mjs

# ---- 生图梯队二（可选）
# 留空 → codex 失败时该张直接报红。
# **任何情况下都不会退化成 SVG/占位图** —— 这是全局硬底线。
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# ---- PG（compose 用）
PG_PASSWORD=CHANGE_ME

# ---- 本地开发：绕过系统代理（重要）
# 系统代理会劫持回环地址，导致 curl / 前端打不到本地 api，返回空响应。
# cli-core 给每个 CLI 子进程强制注入的也是这一对变量。
no_proxy=127.0.0.1,localhost
NO_PROXY=127.0.0.1,localhost
