    "test:version": "node test/version.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:viewport": "node test/viewport.mjs",
    "test:hall-visible": "node test/hall-visible.mjs",
    "test:hall-layout": "node test/hall-layout.mjs",
    "test:game": "npm run fixture:game && node test/game-smoke.mjs",
