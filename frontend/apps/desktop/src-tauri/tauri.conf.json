{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "尘世浮生",
  "version": "0.11.0",
  "identifier": "com.polaris.chenshi",
  "build": {
    "frontendDist": "../../web",
    "beforeBuildCommand": "cd ../../.. && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "尘世浮生 · 一生皆可演绎",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../../../../backend/target/release/chenshi-api", "../../../../backend/target/release/chenshi-worker"],
    "shortDescription": "AI 生成互动人生游戏的工厂与展馆",
    "longDescription": "在创作台里用一句话孵化一部人生模拟游戏，产出单个自包含 HTML；在水晶球大厅里拿起一颗球，走进这段人生。"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.example.com/chenshi/{{target}}/{{arch}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBKEY"
    }
  }
}
